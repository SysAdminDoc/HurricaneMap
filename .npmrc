; Three 2025-2026 npm campaigns delivered their payload as brand-new patch
; versions of packages people already depended on, consumed within minutes of
; publication: "Mini Shai-Hulud" pushed 637 versions across 317 packages in 22
; minutes on 2026-05-19, and CHAINDROP trojanized keyv and cacheable on
; 2026-08-04. A release window costs nothing here, because nothing in this
; repository needs a dependency the day it ships.

; Days, not minutes. npm errors rather than silently resolving something newer
; if no version old enough exists, which is the behaviour we want.
;
; This one constrains the commands that BUILD the tree: npm install and npm
; update, which is when a new version can first enter package-lock.json. npm ci
; installs exactly what the lockfile already pins and does not consult it (npm
; 11.17.0 lists allow-git and ignore-scripts among npm ci's parameters, and not
; this). That is the right division: the window is a review gate on taking a
; new version, and the lockfile is the record that the review happened.
min-release-age=3

; Install scripts are how a trojanized tarball gets to run. Playwright's browser
; download is the one script this repository actually needs, and README asks for
; it explicitly with `npx playwright install` after `npm ci`. This applies to
; npm ci as well as npm install.
ignore-scripts=true

; No dependency here comes from a git reference, and a git dependency is not
; covered by the registry signatures that `npm run check:security` verifies.
; This applies to npm ci as well as npm install.
allow-git=none
