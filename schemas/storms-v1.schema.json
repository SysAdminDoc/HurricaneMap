{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysadmindoc.github.io/HurricaneMap/schemas/storms-v1.schema.json",
  "title": "HurricaneMap storm catalogue v1",
  "$defs": {
    "trackPoint": {
      "type": "object",
      "required": ["t", "lat", "lon", "wind", "pres", "status"],
      "properties": {
        "t": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "wind": { "type": ["number", "null"], "minimum": 0 },
        "pres": { "type": ["number", "null"], "minimum": 0 },
        "status": { "type": "string", "minLength": 1 },
        "rec": { "type": ["string", "null"] },
        "radii": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 12,
          "maxItems": 12
        }
      },
      "additionalProperties": false
    },
    "landfall": {
      "type": "object",
      "required": ["t", "lat", "lon", "wind", "pres", "status", "category", "state", "inferred"],
      "properties": {
        "t": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "wind": { "type": ["number", "null"], "minimum": 0 },
        "pres": { "type": ["number", "null"], "minimum": 0 },
        "status": { "type": "string", "minLength": 1 },
        "rec": { "type": ["string", "null"] },
        "category": { "type": "integer", "minimum": -1, "maximum": 5 },
        "state": { "type": "string", "minLength": 1 },
        "inferred": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "basin", "name", "year", "peak_wind_kt", "min_pres_mb", "peak_status", "landfall_max_category", "landfall_max_wind_kt", "us_landfall_count", "us_landfalls", "track", "similarity_vector"],
    "properties": {
      "id": { "type": "string", "pattern": "^[A-Z]{2}\\d{6}$" },
      "basin": { "enum": ["AL", "EP"] },
      "name": { "type": "string", "minLength": 1 },
      "year": { "type": "integer", "minimum": 1800, "maximum": 2100 },
      "peak_wind_kt": { "type": "number", "minimum": 0 },
      "min_pres_mb": { "type": ["number", "null"], "minimum": 0 },
      "peak_status": { "type": "string", "minLength": 1 },
      "landfall_max_category": { "type": "integer", "minimum": -1, "maximum": 5 },
      "landfall_max_wind_kt": { "type": "number", "minimum": 0 },
      "us_landfall_count": { "type": "integer", "minimum": 1 },
      "us_landfalls": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/landfall" } },
      "track": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/trackPoint" } },
      "similarity_vector": {
        "type": "array",
        "items": { "type": "number", "minimum": 0, "maximum": 1 },
        "minItems": 8,
        "maxItems": 8
      }
    },
    "additionalProperties": false
  }
}
