{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysadmindoc.github.io/HurricaneMap/schemas/saved-views-v1.schema.json",
  "title": "HurricaneMap saved-view export v1",
  "type": "object",
  "required": ["schema_version", "views"],
  "properties": {
    "schema_version": { "const": 1 },
    "views": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "name", "hash", "created_at"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9-]{1,80}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
          "hash": { "type": "string", "minLength": 4, "maxLength": 2048, "pattern": "^#v=1(?:&|$)" },
          "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
