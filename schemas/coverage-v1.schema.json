{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysadmindoc.github.io/HurricaneMap/schemas/coverage-v1.schema.json",
  "title": "HurricaneMap archive coverage contract v1",
  "type": "object",
  "required": ["schema_version", "generated_at_utc", "source_commit", "catalog", "datasets"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "catalog": {
      "type": "object",
      "required": ["basins", "year_range", "storm_count", "landfall_event_count", "hurricane_landfall_count"],
      "properties": {
        "basins": { "type": "array", "items": { "enum": ["AL", "EP"] }, "uniqueItems": true },
        "year_range": {
          "type": "array",
          "prefixItems": [{ "type": "integer" }, { "type": "integer" }],
          "minItems": 2,
          "maxItems": 2
        },
        "storm_count": { "type": "integer", "minimum": 0 },
        "landfall_event_count": { "type": "integer", "minimum": 0 },
        "hurricane_landfall_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dataset" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["name", "url", "revision_date"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "revision_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "basin": { "enum": ["AL", "EP", null] }
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "required": ["runnable", "records", "storms", "frames", "advisories", "marks", "detail"],
      "properties": {
        "runnable": { "type": "boolean" },
        "records": { "type": ["integer", "null"], "minimum": 0 },
        "storms": { "type": ["integer", "null"], "minimum": 0 },
        "frames": { "type": ["integer", "null"], "minimum": 0 },
        "advisories": { "type": ["integer", "null"], "minimum": 0 },
        "marks": { "type": ["integer", "null"], "minimum": 0 },
        "detail": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "required": ["id", "label", "paths", "sources", "basins", "year_range", "end_date", "lifecycle_status", "value_status", "availability", "distribution", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^data/" } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "basins": { "type": "array", "items": { "enum": ["AL", "EP"] }, "uniqueItems": true },
        "year_range": {
          "type": ["array", "null"],
          "prefixItems": [{ "type": "integer" }, { "type": "integer" }],
          "minItems": 2,
          "maxItems": 2
        },
        "end_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "lifecycle_status": { "enum": ["active", "closed", "deprecated"] },
        "value_status": { "enum": ["final", "inferred", "operational", "stale", "closed", "unavailable"] },
        "availability": { "$ref": "#/$defs/availability" },
        "distribution": { "type": "array", "minItems": 1, "items": { "enum": ["core", "full"] }, "uniqueItems": true },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
