{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysadmindoc.github.io/HurricaneMap/schemas/impacts-v1.schema.json",
  "title": "HurricaneMap normalized impacts v1",
  "$defs": {
    "nullableNonNegative": { "type": ["number", "null"], "minimum": 0 }
  },
  "type": "object",
  "patternProperties": {
    "^[A-Z]{2}\\d{6}$": {
      "type": "object",
      "required": ["wiki_title", "wiki_url", "impact_schema_version", "impact_confidence", "impact_confidence_reason", "impact_provenance"],
      "anyOf": [
        { "properties": { "deaths": true }, "required": ["deaths"] },
        { "properties": { "damages": true }, "required": ["damages"] }
      ],
      "properties": {
        "deaths": { "type": "string" },
        "damages": { "type": "string" },
        "wiki_title": { "type": "string", "minLength": 1 },
        "wiki_url": { "type": "string", "pattern": "^https://en\\.wikipedia\\.org/wiki/" },
        "deaths_total": { "$ref": "#/$defs/nullableNonNegative" },
        "deaths_min": { "$ref": "#/$defs/nullableNonNegative" },
        "deaths_max": { "$ref": "#/$defs/nullableNonNegative" },
        "deaths_qualifier": { "type": "string", "minLength": 1 },
        "damage_usd_nominal": { "$ref": "#/$defs/nullableNonNegative" },
        "damage_millions_usd": { "$ref": "#/$defs/nullableNonNegative" },
        "damage_source_units": { "type": "string", "minLength": 1 },
        "damage_qualifier": { "type": "string", "minLength": 1 },
        "damage_prefix": { "type": "string" },
        "damage_suffix": { "type": "string" },
        "damage_usd_min": { "$ref": "#/$defs/nullableNonNegative" },
        "damage_usd_max": { "$ref": "#/$defs/nullableNonNegative" },
        "impact_schema_version": { "const": 1 },
        "impact_confidence": { "enum": ["low", "medium", "high"] },
        "impact_confidence_reason": { "type": "string", "minLength": 1 },
        "impact_provenance": {
          "type": "object",
          "required": ["source", "source_title", "source_url", "scraper", "parsed_at_utc"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "source_title": { "type": "string", "minLength": 1 },
            "source_url": { "type": "string", "pattern": "^https://" },
            "scraper": { "type": "string", "minLength": 1 },
            "parsed_at_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
