{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysadmindoc.github.io/HurricaneMap/schemas/landfalls-v1.schema.json",
  "title": "HurricaneMap landfall catalogue v1",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["storm_id", "name", "year", "t", "lat", "lon", "wind", "pres", "status", "category", "state"],
    "properties": {
      "storm_id": { "type": "string", "pattern": "^[A-Z]{2}\\d{6}$" },
      "name": { "type": "string", "minLength": 1 },
      "year": { "type": "integer", "minimum": 1800, "maximum": 2100 },
      "t": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
      "lat": { "type": "number", "minimum": -90, "maximum": 90 },
      "lon": { "type": "number", "minimum": -180, "maximum": 180 },
      "wind": { "type": ["number", "null"], "minimum": 0 },
      "pres": { "type": ["number", "null"], "minimum": 0 },
      "status": { "type": "string", "minLength": 1 },
      "category": { "type": "integer", "minimum": -1, "maximum": 5 },
      "state": { "type": "string", "minLength": 1 },
      "inferred": { "type": "boolean" }
    },
    "additionalProperties": false
  }
}
